{
  "name": "the-duel-remake",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tools/run-tests.mjs",
    "assets:export": "node tools/export-classic-vehicles.mjs && node tools/export-unlock-vehicles.mjs",
    "assets:audio": "node tools/prepare-audio.mjs",
    "assets:unlocks": "node tools/export-unlock-vehicles.mjs",
    "qa:build": "vite build --config tools/vite-qa.config.js",
